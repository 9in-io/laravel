{
    "name": "9in/laravel",
    "description": "Sign users in to Laravel with 9in: OpenID Connect login with PKCE, a `nine` auth guard with local JWT verification for APIs, and verified webhooks.",
    "keywords": [
        "9in",
        "sso",
        "laravel",
        "oauth2",
        "openid-connect",
        "oidc",
        "pkce",
        "jwt",
        "authentication"
    ],
    "homepage": "https://9in.io",
    "license": "MIT",
    "authors": [
        {
            "name": "9in",
            "email": "support@9in.io"
        },
        {
            "name": "Cubelet Ltd.",
            "homepage": "https://cubelet.co.uk"
        }
    ],
    "require": {
        "php": ">=8.1",
        "laravel/framework": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "9in/php-sdk": "^3.0",
        "9in/laravel-events": "^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.11",
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Nine\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nine\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nine\\Laravel\\NineServiceProvider"
            ],
            "aliases": {
                "Nine": "Nine\\Laravel\\Facades\\Nine"
            }
        },
        "branch-alias": {
            "dev-master": "3.x-dev"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs-fixer": "php-cs-fixer fix"
    }
}
